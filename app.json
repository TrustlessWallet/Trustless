{
  "expo": {
    "name": "Trustless",
    "slug": "Trustless",
    "scheme": "trustless",
    "version": "2.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon-white.png",
      "resizeMode": "cover",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.btc.trustless",
      "icon": "./assets/Trustless.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "Trustless uses the camera to scan Bitcoin address QR codes.",
        "NSFaceIDUsageDescription": "Trustless uses Face ID to secure your wallet.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Trustless uses your location to show nearby Bitcoin merchants on the map."
      }
    },
    "android": {
      "Icon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.btc.trustless",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "buildToolsVersion": "34.0.0",
            "ndkVersion": "27.1.12297006"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Trustless uses your location to show nearby Bitcoin merchants on the map."
        }
      ],
      "@breeztech/breez-sdk-spark-react-native",
      "./src/scripts/withAndroidDisplaySettings",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/SpaceMono-Regular.ttf",
            "./assets/fonts/SpaceMono-Italic.ttf",
            "./assets/fonts/SpaceMono-Bold.ttf",
            "./assets/fonts/SpaceMono-BoldItalic.ttf"
          ]
        }
      ],
      "expo-local-authentication",
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "largeHeap": true,
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-sqlite",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "997b0852-0a8b-434d-8927-dc50771b8b51"
      }
    }
  }
}
